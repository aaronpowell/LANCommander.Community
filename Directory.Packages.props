<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <LANCommanderPackageVersion>2.2.0-alpha.4</LANCommanderPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="LANCommander.SDK" Version="$(LANCommanderPackageVersion)" />
    <PackageVersion Include="LANCommander.Server.Plugins" Version="$(LANCommanderPackageVersion)" />
    <PackageVersion Include="LANCommander.Server.UI" Version="$(LANCommanderPackageVersion)" />

    <PackageVersion Include="Avalonia" Version="11.2.3" />
    <PackageVersion Include="bunit" Version="2.13.3" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.19" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MQTTnet" Version="4.3.7.1207" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
