<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LanCommanderSourceRoot Condition="'$(LanCommanderSourceRoot)' == ''">$(LANCOMMANDER_SOURCE_ROOT)</LanCommanderSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(LanCommanderSourceRoot)' != ''">
    <ProjectReference Include="$(LanCommanderSourceRoot)\LANCommander.SDK\LANCommander.SDK.csproj" />
    <ProjectReference Include="$(LanCommanderSourceRoot)\LANCommander.Launcher.Plugins\LANCommander.Launcher.Plugins.csproj" />
    <ProjectReference Include="$(LanCommanderSourceRoot)\LANCommander.Launcher.Services\LANCommander.Launcher.Services.csproj" />
    <ProjectReference Include="$(LanCommanderSourceRoot)\LANCommander.Launcher.Models\LANCommander.Launcher.Models.csproj" />
    <ProjectReference Include="..\..\src\LanCommander.HomeAssistant.Plugin\LanCommander.HomeAssistant.Plugin.csproj" />
  </ItemGroup>
  <Target Name="RequireLanCommanderSourceRoot" BeforeTargets="PrepareForBuild" Condition="'$(LanCommanderSourceRoot)' == ''">
    <Error Text="Set LanCommanderSourceRoot (or LANCOMMANDER_SOURCE_ROOT) to a LANCommander v2.2.0-alpha.4 source checkout to run loader identity tests." />
  </Target>
</Project>
