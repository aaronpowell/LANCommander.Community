<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>LANCommander.Community.Launcher.MQTT</RootNamespace>
    <AssemblyName>LANCommander.Community.Launcher.MQTT.Plugin</AssemblyName>
    <PackageId>LANCommander.Community.Launcher.MQTT.Plugin</PackageId>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LANCommanderSourceRoot Condition="'$(LANCommanderSourceRoot)' == ''">$(LANCOMMANDER_SOURCE_ROOT)</LANCommanderSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" PrivateAssets="all" />
    <ProjectReference Include="..\LANCommander.Community.Launcher.MQTT.Core\LANCommander.Community.Launcher.MQTT.Core.csproj" />
    <ProjectReference Include="..\LANCommander.Community.Launcher.MQTT.Transport\LANCommander.Community.Launcher.MQTT.Transport.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(LANCommanderSourceRoot)' != ''">
    <ProjectReference Include="$(LANCommanderSourceRoot)\LANCommander.SDK\LANCommander.SDK.csproj" Private="false" PrivateAssets="all" />
    <ProjectReference Include="$(LANCommanderSourceRoot)\LANCommander.Launcher.Plugins\LANCommander.Launcher.Plugins.csproj" Private="false" PrivateAssets="all" />
    <ProjectReference Include="$(LANCommanderSourceRoot)\LANCommander.Launcher.Services\LANCommander.Launcher.Services.csproj" Private="false" PrivateAssets="all" />
    <ProjectReference Include="$(LANCommanderSourceRoot)\LANCommander.Launcher.Models\LANCommander.Launcher.Models.csproj" Private="false" PrivateAssets="all" />
    <ProjectReference Include="$(LANCommanderSourceRoot)\LANCommander.Launcher.Data\LANCommander.Launcher.Data.csproj" Private="false" PrivateAssets="all" />
    <ProjectReference Include="$(LANCommanderSourceRoot)\LANCommander.Launcher.Settings\LANCommander.Launcher.Settings.csproj" Private="false" PrivateAssets="all" />
    <ProjectReference Include="$(LANCommanderSourceRoot)\LANCommander.Packaging\LANCommander.Packaging.csproj" Private="false" PrivateAssets="all" />
    <ProjectReference Include="$(LANCommanderSourceRoot)\LANCommander.Packaging.Abstractions\LANCommander.Packaging.Abstractions.csproj" Private="false" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="RequireLANCommanderSourceRoot" BeforeTargets="PrepareForBuild" Condition="'$(LANCommanderSourceRoot)' == ''">
    <Error Text="Set LANCommanderSourceRoot (or LANCOMMANDER_SOURCE_ROOT) to a LANCommander v2.2.0-alpha.4 source checkout to compile the host adapter." />
  </Target>
  <Target Name="RemoveHostProvidedInterposerRuntime" AfterTargets="Build">
    <Delete Files="$(TargetDir)LANCommander.Interposer.dll;$(TargetDir)x64\LANCommander.Interposer.dll;$(TargetDir)x64\LANCommander.Interposer.Injector.exe;$(TargetDir)x86\LANCommander.Interposer.dll;$(TargetDir)x86\LANCommander.Interposer.Injector.exe" />
  </Target>
  <Target Name="StagePluginPackage" AfterTargets="Build">
    <PropertyGroup>
      <PluginPackageDirectory>$(TargetDir)plugin-package\</PluginPackageDirectory>
    </PropertyGroup>
    <ItemGroup>
      <StalePluginPackageFiles Include="$(PluginPackageDirectory)*.dll;$(PluginPackageDirectory)*.deps.json" />
    </ItemGroup>
    <Delete Files="@(StalePluginPackageFiles)" />
    <MakeDir Directories="$(PluginPackageDirectory)" />
    <Copy
      SourceFiles="$(TargetPath);$(TargetDir)LANCommander.Community.Launcher.MQTT.Core.dll;$(TargetDir)LANCommander.Community.Launcher.MQTT.Transport.dll;$(TargetDir)MQTTnet.dll;$(TargetDir)$(AssemblyName).deps.json"
      DestinationFolder="$(PluginPackageDirectory)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\homeassistant.example.json"
      DestinationFiles="$(PluginPackageDirectory)homeassistant.json"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
