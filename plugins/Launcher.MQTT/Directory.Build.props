<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.props" />
  <PropertyGroup>
    <PluginVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</PluginVersion>
    <Version>$(PluginVersion)</Version>
    <PackageVersion>$(PluginVersion)</PackageVersion>
    <!-- Preserve audit warnings for host source/package dependencies without making them build blockers. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
