<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.props" />
  <PropertyGroup>
    <PluginVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</PluginVersion>
    <Version>$(PluginVersion)</Version>
    <PackageVersion>$(PluginVersion)</PackageVersion>
  </PropertyGroup>
</Project>
