<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <RootNamespace>LANCommander.Community.Server.Mcp</RootNamespace>
    <AssemblyName>LANCommander.Community.Server.Mcp</AssemblyName>
    <PackageId>LANCommander.Community.Server.Mcp</PackageId>
    <Authors>aaronpowell</Authors>
    <Description>Administrator-only MCP catalog management for LANCommander servers.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/aaronpowell/LANCommander.Community</RepositoryUrl>
    <PackageProjectUrl>https://github.com/aaronpowell/LANCommander.Community/tree/main/plugins/Server.Mcp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>LANCommander;plugin;server;mcp</PackageTags>
    <PackageType>LANCommander.Plugin;LANCommander.Plugin.Server</PackageType>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- The host installs the bundled lib folder, not NuGet dependency groups. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackPluginDependencies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="LANCommander.SDK" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <PackageReference Include="LANCommander.Server.Plugins" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <PackageReference Include="LANCommander.Server.UI" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" ExcludeAssets="runtime;native" PrivateAssets="all" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="lib/$(TargetFramework)" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="lib/$(TargetFramework)" />
    <None Include="..\..\licenses\*.txt" Pack="true" PackagePath="lib/$(TargetFramework)/licenses" />
    <EmbeddedResource Include="Pages\setup.mjs" LogicalName="LANCommander.Community.Server.Mcp.setup.mjs" />
  </ItemGroup>
  <Target Name="PackPluginDependencies" DependsOnTargets="Build">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)*.dll" Exclude="$(TargetPath)">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(TargetDir)$(AssemblyName).deps.json">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
