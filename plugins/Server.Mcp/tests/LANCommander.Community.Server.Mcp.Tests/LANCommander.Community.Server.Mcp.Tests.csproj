<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>LANCommander.Community.Server.Mcp.Tests</RootNamespace>
    <AssemblyName>LANCommander.Community.Server.Mcp.Tests</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LANCommander.Community.Server.Mcp\LANCommander.Community.Server.Mcp.csproj" />
    <PackageReference Include="LANCommander.Server.Plugins" />
    <PackageReference Include="LANCommander.Server.UI" />
    <PackageReference Include="bunit" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyPluginBuildOutput" AfterTargets="Build">
    <ItemGroup>
      <PluginFile Include="$(MSBuildProjectDirectory)\..\..\src\LANCommander.Community.Server.Mcp\bin\$(Configuration)\net10.0\*.dll" />
      <PluginFile Include="$(MSBuildProjectDirectory)\..\..\src\LANCommander.Community.Server.Mcp\bin\$(Configuration)\net10.0\*.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFile)" DestinationFolder="$(TargetDir)plugin" />
  </Target>
</Project>
